# ─── Mode ───────────────────────────────────────────
NODE_ENV=development  # development | production

# ─── Server ─────────────────────────────────────────
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

# ─── Database (LOCAL: Docker PostgreSQL) ────────────
# For local Docker:
DATABASE_URL=postgresql://chatuser:chatpass@localhost:5433/chatapp
# For Supabase (production):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── Redis (LOCAL: Docker Redis) ────────────────────
# For local Docker:
REDIS_URL=redis://localhost:6379
# For Upstash (production):
# REDIS_URL=rediss://default:[password]@[endpoint].upstash.io:6379

# ─── JWT ────────────────────────────────────────────
ACCESS_TOKEN_SECRET=your-access-token-secret-min-32-chars
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-chars
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# ─── ImageKit ───────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=your-public-key
IMAGEKIT_PRIVATE_KEY=your-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id

# ─── Email (Nodemailer) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ─── Encryption ────────────────────────────────────
ENCRYPTION_KEY=your-32-byte-hex-key

# ─── LiveKit (audio/video calling) ─────────────────
# From your LiveKit Cloud project (https://cloud.livekit.io). Leave blank to disable calling.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
